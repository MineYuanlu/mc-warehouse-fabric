{
  "schemaVersion": 1,
  "id": "yuanlu-warehouse",
  "version": "${version}",
  "name": "Yuanlu Warehouse",
  "description": "A Minecraft Fabric mod by yuanlu.",
  "authors": ["yuanlu"],
  "contact": {
    "homepage": "https://github.com/MineYuanlu/mc-warehouse",
    "sources": "https://github.com/MineYuanlu/mc-warehouse"
  },
  "license": "MIT",
  "icon": "assets/yuanlu-warehouse/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "bid.yuanlu.mc.warehouse.YuanluWarehouse"
    ],
    "client": [
      "bid.yuanlu.mc.warehouse.client.YuanluWarehouseClient"
    ]
  },
  "mixins": [
    "yuanlu-warehouse.mixins.json",
    {
      "config": "yuanlu-warehouse.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.1",
    "java": ">=25"
  }
}
